# Postgres connection used by the admin GUI.
# Connect as a superuser (or a role with CREATEDB / CREATEROLE) so the
# tool can manage databases, roles, permissions and passwords.
#
# Either set the individual PG* variables...
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
# Maintenance database to connect to for admin operations.
PGDATABASE=postgres

# ...or set a single connection string (takes precedence if present):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Set to "true" only if your server requires SSL (rare for local use).
PGSSL=false
